# =============================================================================
# Backend Environment Configuration
# =============================================================================
# Copy to .env and update values

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patient_healthcare
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Blockchain
RPC_URL=http://localhost:7548
CHAIN_ID=1339
GANACHE_MNEMONIC="test test test test test test test test test test test junk"

# Contract Addresses (populated after deployment)
CONTRACT_USER_REGISTRY=
CONTRACT_MEDICAL_RECORD_REGISTRY=
CONTRACT_CONSENT_MANAGER=
CONTRACT_AUDIT_LOG=

# Backend Wallet (for system transactions - use Ganache account 0 private key)
# Private key for Ganache account 0 (DO NOT USE IN PRODUCTION)
BACKEND_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Encryption
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_ALGORITHM=aes-256-gcm

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage/encrypted
STORAGE_MAX_FILE_SIZE=52428800

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173,http://10.32.2.56:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log