# Frontend Environment Configuration
# Copy to .env.local and update values

# API Base URL - Use your server's LAN IP
VITE_API_BASE_URL=http://10.32.2.56:3000/api

# Blockchain RPC URL - Use ngrok HTTPS URL for remote MetaMask access
# Start ngrok: ngrok start ganache-rpc
# Then update this URL with the ngrok HTTPS endpoint (e.g., https://abc123.ngrok-free.app)
VITE_RPC_URL=https://YOUR_NGROK_DOMAIN

# Chain ID
VITE_CHAIN_ID=1339

# Network Name for MetaMask
VITE_NETWORK_NAME="Patient Healthcare Blockchain"

# Currency Symbol
VITE_CURRENCY_SYMBOL=ETH

# Block Explorer URL (optional)
VITE_BLOCK_EXPLORER_URL=