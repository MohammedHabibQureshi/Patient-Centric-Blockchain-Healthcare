# =============================================================================
# Patient-Centric Blockchain Healthcare Data Sharing System - Environment Config
# =============================================================================
# Copy this file to .env and update values as needed
# NEVER commit .env files to version control

# -----------------------------------------------------------------------------
# NETWORK CONFIGURATION
# -----------------------------------------------------------------------------
# Server's LAN IP address - MUST be changed to your actual LAN IP
# Run 'ipconfig' (Windows) or 'ifconfig' (Linux/Mac) to find your LAN IP
SERVER_LAN_IP=10.32.2.56

# Frontend (Vite) Configuration
VITE_API_BASE_URL=http://${SERVER_LAN_IP}:3000
VITE_RPC_URL=http://${SERVER_LAN_IP}:7548
VITE_CHAIN_ID=1339
VITE_NETWORK_NAME="Patient Healthcare Blockchain"

# Backend Configuration
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patient-centric
DB_USER=postgres
DB_PASSWORD=postgrey
DB_SSL=false

# -----------------------------------------------------------------------------
# BLOCKCHAIN / GANACHE CONFIGURATION
# -----------------------------------------------------------------------------
# Fixed development mnemonic - generates 20 deterministic accounts
# DO NOT USE IN PRODUCTION - This is for development/testing only
GANACHE_MNEMONIC="test test test test test test test test test test test junk"
GANACHE_PORT=7548
GANACHE_HOST=0.0.0.0
GANACHE_CHAIN_ID=1339
GANACHE_NETWORK_ID=1339
GANACHE_ACCOUNTS=20
GANACHE_BLOCK_TIME=0

# -----------------------------------------------------------------------------
# SMART CONTRACT ADDRESSES (Populated after deployment)
# -----------------------------------------------------------------------------
CONTRACT_USER_REGISTRY=
CONTRACT_MEDICAL_RECORD_REGISTRY=
CONTRACT_CONSENT_MANAGER=
CONTRACT_AUDIT_LOG=

# -----------------------------------------------------------------------------
# ENCRYPTION CONFIGURATION
# -----------------------------------------------------------------------------
# Master encryption key for AES-256 file encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT USE IN PRODUCTION - Use proper KMS/HSM
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_IV_LENGTH=16
ENCRYPTION_ALGORITHM=aes-256-gcm

# -----------------------------------------------------------------------------
# STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage/encrypted
STORAGE_MAX_FILE_SIZE=52428800

# IPFS Configuration (Optional - for production)
IPFS_API_URL=
IPFS_GATEWAY_URL=

# -----------------------------------------------------------------------------
# JWT / AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://${SERVER_LAN_IP}:5173

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FILE=./logs/app.log